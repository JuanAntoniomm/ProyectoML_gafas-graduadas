# ---------------------------------------------------------------------------
# DATOS
# ---------------------------------------------------------------------------
# Se publican los CSV del scrapeo para que el repo sea reproducible, pero NO la
# base de datos de la cola: guarda el HTML crudo de las 6.121 fichas y pesa
# 573 MB. GitHub rechaza archivos de más de 100 MB.
#
# OJO con el orden: git no puede "desexcluir" un archivo si su carpeta padre
# está excluida, por eso se ignora el CONTENIDO (data/*) y no la carpeta.
data/*
!data/raw/
data/raw/*
!data/raw/*.csv
!data/raw/.gitkeep
data/raw/*.db
data/raw/*.db-wal
data/raw/*.db-shm
data/raw/*_prueba.csv
data/raw/_debug*.html

# Enriquecimiento generado con IA, descartado del proyecto (decisión D1): la
# tabla correlaba 0,642 con los precios reales y erraba un 66,8 % de mediana.
# Se conserva en local como evidencia del análisis, pero no forma parte del repo.
data/raw/marcas_tier.csv
data/raw/materiales_tier.csv
data/raw/clasf_*.md

# Dataset de la fuente anterior (Lentiamo). Se conserva en local porque es la
# única fuente del peso de la montura, pendiente de recuperar cruzando por
# código de modelo. No pertenece a la v2.
data/raw/lentiamo_*.csv

# ---------------------------------------------------------------------------
# PERSONAL — nunca debe salir del ordenador
# ---------------------------------------------------------------------------
busquedatrabajo.md
curriculum.md
óptica-productividad.md
CLAUDE.md

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Entornos virtuales
.env
.venv
env/
venv/

# Jupyter
.ipynb_checkpoints/

# IDEs
.vscode/
.idea/

# Sistema
.DS_Store
Thumbs.db

# Archivo vacío de pruebas, sin uso
_wtest

# Script auxiliar de commits, no forma parte del proyecto
hacer_commits_v2.sh

# Script auxiliar de commits, no forma parte del proyecto
hacer_commits_v2b.sh
